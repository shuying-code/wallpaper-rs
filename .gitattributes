# 统一换行与二进制检测：仓库内文本一律使用 LF
* text=auto eol=lf

*.rs    text eol=lf
*.toml  text eol=lf
*.lock  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.sh    text eol=lf
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不做换行转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.icns    binary
*.exe     binary
*.dll     binary
*.so      binary
*.dylib   binary
*.apk     binary
*.zip     binary
*.tar.gz  binary
*.AppImage binary
